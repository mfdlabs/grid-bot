    {
      "type": "stat",
      "title": "Error ratio",
      "description": "Exceptions and timeouts as a share of executions, excluding rejected requests, over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase({__name__=~\"gridbot_(command|interaction|script|render)_executions_total\",environment=\"$environment\",outcome=~\"exception|timeout\"}[$__range])) / sum(increase({__name__=~\"gridbot_(command|interaction|script|render)_executions_total\",environment=\"$environment\",outcome!=\"rejected\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
