{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "grid-bot-traces"
  },
  "spec": {
    "title": "Grid Bot / Traces",
    "description": "Traces for command and interaction executions, per environment, and a single trace by ID.",
    "editable": true,
    "preload": false,
    "liveNow": false,
    "cursorSync": "Crosshair",
    "tags": ["grid-bot"],
    "timeSettings": {
      "from": "now-6h",
      "to": "now",
      "timezone": "browser",
      "autoRefresh": "30s",
      "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "links": [
      {
        "type": "dashboards",
        "title": "Grid Bot",
        "tags": ["grid-bot"],
        "asDropdown": true,
        "includeVars": true,
        "keepTime": true,
        "icon": "external link",
        "targetBlank": false,
        "tooltip": "",
        "url": ""
      },
      {
        "type": "link",
        "title": "Logs for this trace",
        "url": "/d/grid-bot-logs?${__url_time_range}&var-environment=${environment}&var-trace_id=${trace_id}",
        "icon": "external link",
        "targetBlank": false
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "name": "Restarts",
          "enable": true,
          "hide": false,
          "iconColor": "blue",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": { "name": "${datasource}" },
            "spec": {
              "expr": "sum(changes(process_start_time_seconds{environment=\"$environment\"}[1m])) > 0",
              "titleFormat": "Restart",
              "step": "60s",
              "useValueForTime": false
            }
          }
        }
      }
    ],
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "label": "Data source",
          "pluginId": "prometheus",
          "refresh": "load",
          "regex": "",
          "current": { "text": "", "value": "" },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "environment",
          "label": "Environment",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": { "name": "${datasource}" },
            "spec": {
              "qryType": 1,
              "query": "label_values(gridbot_build_info, environment)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "definition": "label_values(gridbot_build_info, environment)",
          "refresh": "onTimeRangeChanged",
          "sort": "alphabeticalAsc",
          "regex": "",
          "current": { "text": "", "value": "" },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "jaeger",
          "label": "Traces",
          "pluginId": "jaeger",
          "refresh": "load",
          "regex": "",
          "current": { "text": "", "value": "" },
          "options": [],
          "multi": false,
          "includeAll": false,
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "service",
          "label": "Service",
          "description": "The service.name the bot reports, TracingServiceName.",
          "query": "grid-bot",
          "current": { "text": "grid-bot", "value": "grid-bot" },
          "hide": "dontHide",
          "skipUrlSync": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "tags",
          "label": "Extra tags",
          "description": "Optional span tags to filter the tables by, as space separated key=value pairs, for example gridbot.command.name=render or gridbot.outcome=success.",
          "query": "",
          "current": { "text": "", "value": "" },
          "hide": "dontHide",
          "skipUrlSync": false
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_id",
          "label": "Trace ID",
          "description": "Show a single trace. Clicking a trace ID in a table, or an exemplar on a latency panel, fills this in.",
          "query": "",
          "current": { "text": "", "value": "" },
          "hide": "dontHide",
          "skipUrlSync": false
        }
      }
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "",
          "description": "",
          "transparent": true,
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": { "queries": [], "queryOptions": {}, "transformations": [] }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Select a trace from a table below to open it here, or enter a trace ID in **Trace ID** above."
              },
              "fieldConfig": { "defaults": {}, "overrides": [] }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Trace $trace_id",
          "description": "The trace with the ID in the Trace ID variable.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "jaeger",
                      "version": "v0",
                      "datasource": { "name": "${jaeger}" },
                      "spec": { "query": "$trace_id" }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "traces",
            "version": "13.0.0",
            "spec": {
              "options": {},
              "fieldConfig": { "defaults": {}, "overrides": [] }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Command executions",
          "description": "Text commands, newest first. Select a trace ID to open it above.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "jaeger",
                      "version": "v0",
                      "datasource": { "name": "${jaeger}" },
                      "spec": {
                        "queryType": "search",
                        "service": "$service",
                        "operation": "command.execute",
                        "tags": "deployment.environment.name=$environment $tags",
                        "minDuration": "",
                        "maxDuration": "",
                        "limit": 50
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.0",
            "spec": {
              "options": { "showHeader": true },
              "fieldConfig": {
                "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
                "overrides": [
                  {
                    "matcher": { "id": "byRegexp", "options": "/^(trace ?id)$/i" },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open trace here",
                            "url": "/d/grid-bot-traces?${__url_time_range}&var-datasource=${datasource}&var-environment=${environment}&var-jaeger=${jaeger}&var-service=${service}&${tags:queryparam}&var-trace_id=${__value.raw}"
                          },
                          {
                            "title": "Open trace in Explore",
                            "targetBlank": true,
                            "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22${jaeger}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22jaeger%22%2C%22uid%22%3A%22${jaeger}%22%7D%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D&orgId=1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Interaction executions",
          "description": "Interactions, newest first. Select a trace ID to open it above.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "jaeger",
                      "version": "v0",
                      "datasource": { "name": "${jaeger}" },
                      "spec": {
                        "queryType": "search",
                        "service": "$service",
                        "operation": "interaction.execute",
                        "tags": "deployment.environment.name=$environment $tags",
                        "minDuration": "",
                        "maxDuration": "",
                        "limit": 50
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.0",
            "spec": {
              "options": { "showHeader": true },
              "fieldConfig": {
                "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
                "overrides": [
                  {
                    "matcher": { "id": "byRegexp", "options": "/^(trace ?id)$/i" },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open trace here",
                            "url": "/d/grid-bot-traces?${__url_time_range}&var-datasource=${datasource}&var-environment=${environment}&var-jaeger=${jaeger}&var-service=${service}&${tags:queryparam}&var-trace_id=${__value.raw}"
                          },
                          {
                            "title": "Open trace in Explore",
                            "targetBlank": true,
                            "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22${jaeger}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22jaeger%22%2C%22uid%22%3A%22${jaeger}%22%7D%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D&orgId=1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Failed executions",
          "description": "Any traced work that ended with the exception outcome. Select a trace ID to open it above.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "jaeger",
                      "version": "v0",
                      "datasource": { "name": "${jaeger}" },
                      "spec": {
                        "queryType": "search",
                        "service": "$service",
                        "operation": "",
                        "tags": "deployment.environment.name=$environment gridbot.outcome=exception",
                        "minDuration": "",
                        "maxDuration": "",
                        "limit": 50
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.0",
            "spec": {
              "options": { "showHeader": true },
              "fieldConfig": {
                "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
                "overrides": [
                  {
                    "matcher": { "id": "byRegexp", "options": "/^(trace ?id)$/i" },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open trace here",
                            "url": "/d/grid-bot-traces?${__url_time_range}&var-datasource=${datasource}&var-environment=${environment}&var-jaeger=${jaeger}&var-service=${service}&${tags:queryparam}&var-trace_id=${__value.raw}"
                          },
                          {
                            "title": "Open trace in Explore",
                            "targetBlank": true,
                            "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22${jaeger}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22jaeger%22%2C%22uid%22%3A%22${jaeger}%22%7D%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D&orgId=1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Timed out executions",
          "description": "Any traced work that ended with the timeout outcome. Select a trace ID to open it above.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "jaeger",
                      "version": "v0",
                      "datasource": { "name": "${jaeger}" },
                      "spec": {
                        "queryType": "search",
                        "service": "$service",
                        "operation": "",
                        "tags": "deployment.environment.name=$environment gridbot.outcome=timeout",
                        "minDuration": "",
                        "maxDuration": "",
                        "limit": 50
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.0",
            "spec": {
              "options": { "showHeader": true },
              "fieldConfig": {
                "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
                "overrides": [
                  {
                    "matcher": { "id": "byRegexp", "options": "/^(trace ?id)$/i" },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Open trace here",
                            "url": "/d/grid-bot-traces?${__url_time_range}&var-datasource=${datasource}&var-environment=${environment}&var-jaeger=${jaeger}&var-service=${service}&${tags:queryparam}&var-trace_id=${__value.raw}"
                          },
                          {
                            "title": "Open trace in Explore",
                            "targetBlank": true,
                            "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22${jaeger}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22jaeger%22%2C%22uid%22%3A%22${jaeger}%22%7D%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D&orgId=1"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Select a trace",
              "hideHeader": true,
              "collapse": false,
              "conditionalRendering": {
                "kind": "ConditionalRenderingGroup",
                "spec": {
                  "visibility": "show",
                  "condition": "and",
                  "items": [
                    {
                      "kind": "ConditionalRenderingVariable",
                      "spec": { "variable": "trace_id", "operator": "notMatches", "value": ".+" }
                    }
                  ]
                }
              },
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 3,
                        "element": { "kind": "ElementReference", "name": "panel-1" }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Trace by ID",
              "collapse": false,
              "conditionalRendering": {
                "kind": "ConditionalRenderingGroup",
                "spec": {
                  "visibility": "show",
                  "condition": "and",
                  "items": [
                    {
                      "kind": "ConditionalRenderingVariable",
                      "spec": { "variable": "trace_id", "operator": "matches", "value": ".+" }
                    }
                  ]
                }
              },
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 14,
                        "element": { "kind": "ElementReference", "name": "panel-2" }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Traces in $environment",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 12,
                        "height": 10,
                        "element": { "kind": "ElementReference", "name": "panel-3" }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 0,
                        "width": 12,
                        "height": 10,
                        "element": { "kind": "ElementReference", "name": "panel-4" }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Failures",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 12,
                        "height": 10,
                        "element": { "kind": "ElementReference", "name": "panel-5" }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 0,
                        "width": 12,
                        "height": 10,
                        "element": { "kind": "ElementReference", "name": "panel-6" }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
