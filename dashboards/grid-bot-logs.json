{
  "uid": "grid-bot-logs",
  "title": "Grid Bot / Logs",
  "description": "OTLP logs from Grid Bot, filtered by environment, logger, level, trace ID, and text.",
  "version": 1,
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "grid-bot"
  ],
  "links": [
    {
      "type": "dashboards",
      "title": "Grid Bot",
      "tags": [
        "grid-bot"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "link",
      "title": "Trace this ID",
      "url": "/d/grid-bot-traces?${__url_time_range}&var-environment=${environment}&var-trace_id=${trace_id}",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "regex": "",
        "multi": false,
        "includeAll": false
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "query": "label_values({service_name=\"grid-bot\"}, deployment_environment_name)",
        "definition": "label_values({service_name=\"grid-bot\"}, deployment_environment_name)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "regex": "",
        "current": {}
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "Error,Warning,Information,Debug,Trace",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0
      },
      {
        "name": "logger",
        "label": "Logger (group)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "description": "Enter a trace ID to filter logs and enable the Trace this ID dashboard link.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "session_id",
        "label": "Session ID",
        "type": "textbox",
        "description": "Enter a session ID (or its prefix) to show logs from a single run of the app. It is logged at startup.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "Number of log records ingested per level.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (severity_text) (count_over_time({service_name=\"grid-bot\", deployment_environment_name=\"$environment\"} | severity_text=~\"$level\" | logger_name=~\"$logger\" | trace_id=~\"$trace_id.*\" | session_id=~\"$session_id.*\" |~ \"$search\" [$__interval]))",
          "legendFormat": "{{severity_text}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Log records",
      "description": "Select a trace ID from log details and enter it in the Trace ID filter to focus on one request.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "{service_name=\"grid-bot\", deployment_environment_name=\"$environment\"} | severity_text=~\"$level\" | logger_name=~\"$logger\" | trace_id=~\"$trace_id.*\" | session_id=~\"$session_id.*\" |~ \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 8
      }
    }
  ]
}
