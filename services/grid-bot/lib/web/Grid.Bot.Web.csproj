<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Library containing implementation for Web based code in grid-bot. Port of @mfdlabs/grid-service-websrv to C#</Description>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Label="GridBotPackages">
    <ProjectReference Include="../settings/Grid.Bot.Settings.csproj" />
    <ProjectReference Include="../utility/Grid.Bot.Utility.csproj" />
    <ProjectReference Include="../client-settings/Grid.Bot.ClientSettings.csproj" />
  </ItemGroup>

  <ItemGroup Label="CustomPackages">
    <ProjectReference Include="$(RootDirectory)lib/logging/logging/Logging.csproj" />
  </ItemGroup>

  <ItemGroup Label="NuGetPackages">
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="VaultSharp" Version="1.13.0.1" />

    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
